@using Narratify.Models.ViewModels.Articles
@model BlogViewModel

@{ 
    ViewData["Title"] = Model.Article.Title;
}

@await Html.PartialAsync("_Alert")

<!-- Article Header -->
<section class="bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-100 border-b border-gray-200 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8">
            <div class="inline-flex items-center space-x-2 bg-white/60 backdrop-blur-sm rounded-full px-4 py-2 border border-white/20 mb-6">
                <i class="fas fa-clock text-purple-500"></i>
                <span class="text-gray-700 font-medium">@Model.Article.ReadingTimeMinutes min read</span>
                <span class="text-gray-400">•</span>
                <i class="fas fa-eye text-blue-500"></i>
                <span class="text-gray-700 font-medium">@(Model.Article?.ViewCount ?? 0) views</span>
            </div>
            
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold bg-gradient-to-r from-purple-600 via-blue-600 to-indigo-600 bg-clip-text text-transparent leading-tight mb-8">
                @Model.Article.Title
            </h1>
        </div>
        
        <!-- Author Info -->
        <div class="flex items-center justify-center">
            <div class="bg-white/80 backdrop-blur-xl border border-white/20 rounded-2xl p-6 shadow-xl">
                <div class="flex items-center space-x-4">
                    <div class="relative">
                        <img class="h-16 w-16 rounded-full border-4 border-white shadow-lg" 
                             src="@Model.Article.Author.GetProfilePictureOrDefault()" 
                             alt="@Model.Article.Author.DisplayName">
                        <div class="absolute -bottom-1 -right-1 w-6 h-6 bg-gradient-to-r from-purple-500 to-blue-500 rounded-full flex items-center justify-center border-2 border-white">
                            <i class="fas fa-feather-alt text-white text-xs"></i>
                        </div>
                    </div>
                    <div>
                        <p class="text-lg font-bold text-gray-900">
                            <a asp-controller="Account" asp-action="Profile" asp-route-id="@Model.Article.Author.Id" 
                               class="hover:text-purple-600 transition-colors duration-300">@Model.Article.Author.DisplayName</a>
                        </p>
                        <p class="text-sm text-gray-600">
                            <time datetime="@Model.Article.PublishedAt?.ToString("yyyy-MM-dd")">
                                @Model.Article.PublishedAt?.ToString("MMMM dd, yyyy")
                            </time>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Article Content -->
<article class="bg-white py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-2xl shadow-lg border-2 border-gray-100 p-8 md:p-12">
            <div id="article-content" class="preview prose prose-lg prose-gray max-w-none prose-content">
                @Html.Raw(Model.Article.HtmlContent)
            </div>
        </div>
    </div>
</article>

<!-- Comments Section -->
<section class="bg-white py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-2xl shadow-lg border-2 border-gray-100 p-8">
            <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center space-x-3">
                <i class="fas fa-comments text-purple-500"></i>
                <span>Comments (@Model.Comments.Count)</span>
            </h2>
            
            <!-- New Comment Form -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="mb-12">
                    <div class="bg-white rounded-xl border-2 border-gray-200 p-6">
                        <h3 class="text-lg font-semibold text-gray-900 mb-4 flex items-center space-x-2">
                            <i class="fas fa-plus-circle text-purple-500"></i>
                            <span>Add a comment</span>
                        </h3>
                        <form asp-controller="Articles" asp-action="PostComment" method="post" class="space-y-4">
                            <input type="hidden" name="ArticleId" value="@Model.Article.Id" />
                            <input type="hidden" name="ArticleSlug" value="@Model.Article.Slug" />
                            <div class="relative">
                                <div class="absolute top-3 left-3 pointer-events-none">
                                    <i class="fas fa-comment text-gray-400"></i>
                                </div>
                                <textarea name="NewCommentContent" rows="4" 
                                          class="w-full pl-10 pr-4 py-3 border-2 border-gray-200 rounded-xl shadow-sm placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:border-transparent transition-all duration-300 resize-none" 
                                          placeholder="Share your thoughts about this article..." required></textarea>
                            </div>
                            <div class="flex justify-end">
                                <button type="submit" 
                                        class="btn-primary text-white px-6 py-3 rounded-xl font-semibold flex items-center space-x-2">
                                    <i class="fas fa-paper-plane"></i>
                                    <span>Post Comment</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div class="mb-12">
                    <div class="bg-gradient-to-br from-purple-50 to-blue-50 rounded-xl border-2 border-dashed border-purple-200 p-8 text-center">
                        <div class="w-16 h-16 bg-gradient-to-r from-purple-500 to-blue-500 rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="fas fa-user-plus text-white text-xl"></i>
                        </div>
                        <h3 class="text-xl font-bold text-gray-900 mb-2">Join the conversation</h3>
                        <p class="text-gray-600 mb-6">Sign in to share your thoughts and engage with the community.</p>
                        <div class="flex flex-col sm:flex-row gap-4 justify-center">
                            <a asp-controller="Account" asp-action="Login" 
                               class="btn-primary text-white px-6 py-3 rounded-xl font-semibold inline-flex items-center justify-center space-x-2">
                                <i class="fas fa-sign-in-alt"></i>
                                <span>Sign In</span>
                            </a>
                            <a asp-controller="Account" asp-action="Register" 
                               class="bg-white text-gray-700 border-2 border-gray-200 hover:border-purple-300 px-6 py-3 rounded-xl font-semibold transition-all duration-300 inline-flex items-center justify-center space-x-2">
                                <i class="fas fa-user-plus"></i>
                                <span>Sign Up</span>
                            </a>
                        </div>
                    </div>
                </div>
            }

            <!-- Comments List -->
            @if (Model.Comments.Any())
            {
                <div class="space-y-6">
                    @foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAt))
                    {
                        <div class="bg-white rounded-xl border-2 border-gray-100 p-6 hover:border-purple-200 transition-all duration-300">
                            <div class="flex items-start space-x-4">
                                <img class="h-12 w-12 rounded-full border-2 border-purple-200" 
                                     src="@(comment.User?.GetProfilePictureOrDefault() ?? "https://ui-avatars.com/api/?name=User&background=667eea&color=fff")" 
                                     alt="@(comment.User?.DisplayName ?? "Unknown User")">
                                <div class="flex-1">
                                    <div class="flex items-center justify-between mb-2">
                                        <div>
                                            <h4 class="font-semibold text-gray-900">@(comment.User?.DisplayName ?? "Unknown User")</h4>
                                            <p class="text-sm text-gray-500">
                                                @{
                                                    // Convert UTC time to IST (UTC +5:30)
                                                    var istTime = TimeZoneInfo.ConvertTimeFromUtc(
                                                        comment.CreatedAt,
                                                        TimeZoneInfo.FindSystemTimeZoneById("India Standard Time")
                                                    );
                                                }
                                                <time datetime="@istTime.ToString("yyyy-MM-ddTHH:mm:ss")">
                                                    @istTime.ToString("MMMM dd, yyyy 'at' h:mm tt")
                                                </time>
                                            </p>
                                        </div>
                                        @if (User.Identity?.IsAuthenticated == true && (comment.UserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value || User.IsInRole("Admin")))
                                        {
                                            <form asp-controller="Comments" asp-action="Delete" asp-route-id="@comment.Id" asp-route-returnUrl="@Context.Request.Path" method="post" class="inline" onsubmit="return confirmDelete(event)">
                                                <button type="submit" 
                                                        class="text-red-500 hover:text-red-600 transition-colors duration-300 p-2 rounded-full hover:bg-red-50" 
                                                        title="Delete comment">
                                                    <i class="fas fa-trash text-sm"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                    <div class="text-gray-700 leading-relaxed">
                                        @Html.Raw(comment.Content)
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-12">
                    <div class="w-16 h-16 bg-gradient-to-r from-gray-400 to-gray-500 rounded-full flex items-center justify-center mx-auto mb-4">
                        <i class="fas fa-comments text-white text-xl"></i>
                    </div>
                    <h3 class="text-xl font-bold text-gray-900 mb-2">No comments yet</h3>
                    <p class="text-gray-600">Be the first to share your thoughts about this article.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Related Articles -->
<section class="bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-100 py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8">
            <h2 class="text-3xl font-bold text-gray-900 flex items-center justify-center space-x-3">
                <i class="fas fa-book-open text-purple-500"></i>
                <span>More Stories</span>
            </h2>
            <p class="mt-2 text-gray-600">Discover more amazing content from our community</p>
        </div>
        
        <div class="text-center">
            <a asp-controller="Articles" asp-action="Browse" 
               class="btn-primary text-white px-8 py-4 rounded-xl font-semibold text-lg inline-flex items-center space-x-2">
                <i class="fas fa-arrow-right"></i>
                <span>Explore All Articles</span>
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <link rel="stylesheet" href="~/css/markdown.css" />
    <script>
        function confirmDelete(event) {
            return confirm('Are you sure you want to delete this comment? This action cannot be undone.');
        }
    </script>
}
