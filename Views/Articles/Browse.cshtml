@using Narratify.Models.ViewModels.Articles
@model BrowseArticlesViewModel

@{
    ViewData["Title"] = "Browse Articles";
}

@await Html.PartialAsync("_Alert")

<!-- Browse Header -->
<section class="bg-gradient-to-br from-purple-50 via-blue-50 to-indigo-100 border-b border-gray-200 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <div class="inline-flex items-center space-x-3 mb-6">
                <div class="w-16 h-16 bg-gradient-to-r from-purple-500 to-blue-500 rounded-2xl flex items-center justify-center">
                    <i class="fas fa-book-open text-white text-2xl"></i>
                </div>
            </div>
            <h1 class="text-5xl md:text-6xl font-bold bg-gradient-to-r from-purple-600 via-blue-600 to-indigo-600 bg-clip-text text-transparent leading-tight mb-6">
                Discover Stories
            </h1>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto leading-relaxed mb-8">
                Explore thought-provoking articles, inspiring stories, and creative insights from our talented community of writers.
            </p>
            
            <!-- Stats -->
            <div class="inline-flex items-center space-x-2 bg-white/60 backdrop-blur-sm rounded-full px-6 py-3 border border-white/20">
                <i class="fas fa-chart-line text-purple-500"></i>
                <span class="text-gray-700 font-medium">
                    @(Model.Articles?.Count ?? 0) of @Model.TotalArticles articles
                </span>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="mt-8">
                    <a asp-controller="Articles" asp-action="Create" 
                       class="btn-primary text-white px-8 py-4 rounded-xl font-semibold text-lg inline-flex items-center space-x-2">
                        <i class="fas fa-plus"></i>
                        <span>Write Your Story</span>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Filters Section -->
<section class="bg-white py-8 border-b border-gray-100">
    <form method="get" asp-action="Browse" asp-controller="Articles">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"> 
        <div class="flex flex-col md:flex-row items-center justify-between space-y-4 md:space-y-0">
            <!-- Search -->
            <div class="relative flex-1 max-w-md"> 
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i class="fas fa-search text-gray-400"></i>
                </div>
                <div class="relative flex-1 max-w-md">
                    <input type="text"
                       name="search"
                       value="@Context.Request.Query["search"]"
                       placeholder="Search articles..."
                       class="w-full pl-10 pr-4 py-3 border-2 rounded-xl"
                       onkeydown="if(event.key === 'Enter'){ this.form.submit(); }">
                </div>
            </div>

            <!-- Sort -->
            <div class="flex items-center space-x-4">
                <label class="text-sm font-medium text-gray-700">Sort by:</label>
                <select name="sort" onchange="this.form.submit()">
                    <option value="Latest" selected="@("Latest" == Context.Request.Query["sort"])">Latest</option>
                    <option value="Popular" selected="@("Popular" == Context.Request.Query["sort"])">Most Popular</option>
                    <option value="Most Commented" selected="@("Most Commented" == Context.Request.Query["sort"])">Most Commented</option>
                    <option value="Oldest" selected="@("Oldest" == Context.Request.Query["sort"])">Oldest</option>
                </select>
            </div>
            </div>    
            </div>
    </form>
</section>

<!-- Articles Grid -->
<section class="bg-white py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        @if (Model.Articles != null && Model.Articles.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var article in Model.Articles)
                {
                    <article class="bg-gradient-to-br from-white to-gray-50 rounded-2xl shadow-lg border-2 border-gray-100 hover:border-purple-200 transition-all duration-300 overflow-hidden group">
                        <!-- Article Image Placeholder -->
                        <div class="h-48 bg-gradient-to-br from-purple-100 to-blue-100 flex items-center justify-center">
                            <div class="w-16 h-16 bg-gradient-to-r from-purple-500 to-blue-500 rounded-full flex items-center justify-center">
                                <i class="fas fa-feather-alt text-white text-xl"></i>
                            </div>
                        </div>

                        <div class="p-6">
                            <!-- Article Meta -->
                            <div class="flex items-center justify-between mb-4">
                                <div class="flex items-center space-x-3">
                                    <img class="h-8 w-8 rounded-full border-2 border-purple-200" 
                                         src="@(article.Author?.GetProfilePictureOrDefault() ?? "https://ui-avatars.com/api/?name=Author&background=667eea&color=fff")" 
                                         alt="@article.Author?.DisplayName">
                                    <div>
                                        <p class="text-sm font-medium text-gray-900">@article.Author?.DisplayName</p>
                                        <p class="text-xs text-gray-500">@article.PublishedAt?.ToString("MMM dd, yyyy")</p>
                                    </div>
                                </div>
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700 border border-green-200">
                                    <i class="fas fa-globe mr-1"></i>
                                    Published
                                </span>
                            </div>
                            
                            <!-- Article Content -->
                            <a href="/Articles/@article.Slug" class="block group-hover:text-purple-600 transition-colors duration-300">
                                <h3 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2">@article.Title</h3>
                                <p class="text-gray-600 text-sm leading-relaxed line-clamp-3 mb-4">@(article.Summary ?? "Discover what this article has to offer...")</p>
                            </a>
                            
                            <!-- Article Stats -->
                            <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                                <div class="flex items-center space-x-4 text-sm text-gray-500">
                                    <span class="flex items-center space-x-1">
                                        <i class="fas fa-eye"></i>
                                        <span>@(article?.ViewCount ?? 0)</span>
                                    </span>
                                    <span class="flex items-center space-x-1">
                                        <i class="fas fa-comments"></i>
                                        <span>@(article.Comments?.Count ?? 0)</span>
                                    </span>
                                    <span class="flex items-center space-x-1">
                                        <i class="fas fa-clock"></i>
                                        <span>5 min read</span>
                                    </span>
                                </div>
                                <a href="/Articles/@article.Slug" class="text-purple-600 hover:text-purple-700 font-medium text-sm transition-colors duration-300">
                                    Read more →
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="mt-12 flex justify-center">
                    <nav class="flex items-center space-x-2">
                        <!-- Previous Button -->
                        <a asp-action="Browse"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-search="@Context.Request.Query["search"]"
                           asp-route-sort="@Context.Request.Query["sort"]"
                           class="px-4 py-2 border-2 border-gray-200 rounded-xl text-gray-500 hover:border-purple-300 hover:text-purple-600 transition-all duration-300 @(Model.HasPreviousPage ? "" : "pointer-events-none opacity-50")">
                            <i class="fas fa-chevron-left"></i>
                        </a>

                        <!-- Page Numbers -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <a asp-action="Browse"
                               asp-route-page="@i"
                               asp-route-search="@Context.Request.Query["search"]"
                               asp-route-sort="@Context.Request.Query["sort"]"
                               class="px-4 py-2 rounded-xl font-medium transition-all duration-300 @(i == Model.CurrentPage ? "bg-gradient-to-r from-purple-500 to-blue-500 text-white" : "border-2 border-gray-200 text-gray-700 hover:border-purple-300 hover:text-purple-600")">
                                @i
                            </a>
                        }

                        <!-- Next Button -->
                        <a asp-action="Browse"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-search="@Context.Request.Query["search"]"
                           asp-route-sort="@Context.Request.Query["sort"]"
                           class="px-4 py-2 border-2 border-gray-200 rounded-xl text-gray-500 hover:border-purple-300 hover:text-purple-600 transition-all duration-300 @(Model.HasNextPage ? "" : "pointer-events-none opacity-50")">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    </nav>
                </div>
            }
        }
        else
        {
            <div class="text-center py-16">
                <div class="bg-gradient-to-br from-purple-50 to-blue-50 rounded-2xl p-12 border-2 border-dashed border-purple-200 max-w-md mx-auto">
                    <div class="w-20 h-20 bg-gradient-to-r from-purple-500 to-blue-500 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i class="fas fa-book-open text-white text-2xl"></i>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-4">No articles found</h3>
                    <p class="text-gray-600 mb-8">Be the first to share your story with the community.</p>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Articles" asp-action="Create" 
                           class="btn-primary text-white px-8 py-4 rounded-xl font-semibold text-lg inline-flex items-center space-x-2">
                            <i class="fas fa-plus"></i>
                            <span>Write First Article</span>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" 
                           class="btn-primary text-white px-8 py-4 rounded-xl font-semibold text-lg inline-flex items-center space-x-2">
                            <i class="fas fa-user-plus"></i>
                            <span>Join Narratify</span>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</section>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
