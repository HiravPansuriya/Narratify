@{
    ViewData["Title"] = "Admin Overview";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<header>
    <h1 class="text-3xl font-extrabold tracking-tight text-gray-900">Admin Overview</h1>
</header>

<!-- Stats Cards -->
<section class="mt-8 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200">
        <div class="p-5">
            <p class="text-sm font-medium text-gray-500 truncate">Total Users</p>
            <p class="mt-1 text-3xl font-semibold text-gray-900">4,128</p>
        </div>
    </div>
    <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200">
        <div class="p-5">
            <p class="text-sm font-medium text-gray-500 truncate">Total Posts</p>
            <p class="mt-1 text-3xl font-semibold text-gray-900">9,721</p>
        </div>
    </div>
    <div class="bg-white overflow-hidden shadow-sm rounded-lg border border-gray-200">
        <div class="p-5">
            <p class="text-sm font-medium text-gray-500 truncate">Comments This Week</p>
            <p class="mt-1 text-3xl font-semibold text-gray-900">1,492</p>
        </div>
    </div>
</section>

<!-- Recent Users Table -->
<section class="mt-10">
    <h2 class="text-xl font-bold tracking-tight text-gray-900">Recent Users</h2>
    <div class="mt-4 bg-white shadow-sm rounded-lg border border-gray-200 overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Email</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Joined Date</th>
                    <th scope="col" class="relative px-6 py-3"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Herman Schmidt</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">herman.schmidt@example.com</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">2025-09-19</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <a href="#" class="text-gray-600 hover:text-gray-900">View</a>
                    </td>
                </tr>
                 <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Jane Doe</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">jane.doe@example.com</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">2025-09-18</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <a href="#" class="text-gray-600 hover:text-gray-900">View</a>
                    </td>
                </tr>
                <tr>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">Klaus Richter</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">klaus.richter@example.com</td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">2025-09-17</td>
                    <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                        <a href="#" class="text-gray-600 hover:text-gray-900">View</a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</section>
