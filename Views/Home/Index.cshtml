@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <!-- Hero Section -->
    <section class="text-center">
        <h1 class="text-4xl md:text-6xl font-extrabold tracking-tighter text-gray-900 leading-tight">
            Clarity in Thought.
        </h1>
        <p class="mt-4 max-w-2xl mx-auto text-lg md:text-xl text-gray-500">
            A minimal space for focused writing and reading. Share your ideas with the world, without the noise.
        </p>
        <div class="mt-8">
            <a asp-controller="Account" asp-action="Register" class="inline-block bg-gray-900 text-white hover:bg-gray-700 px-8 py-3 rounded-md text-base font-medium">
                Start Writing
            </a>
        </div>
    </section>

    <!-- Featured Blogs Section -->
    <section class="mt-16 md:mt-24">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tight text-gray-900">Featured Stories</h2>
        <div class="mt-8 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            <!-- Blog Card 1 -->
            <div class="flex flex-col rounded-lg shadow-sm border border-gray-200 overflow-hidden">
                <div class="flex-shrink-0">
                    <img class="h-48 w-full object-cover" src="https://placehold.co/600x400/e2e8f0/e2e8f0" alt="">
                </div>
                <div class="flex-1 bg-white p-6 flex flex-col justify-between">
                    <div class="flex-1">
                        <p class="text-sm font-medium text-gray-500">
                            <a href="#" class="hover:underline">Design Principles</a>
                        </p>
                        <a asp-controller="Articles" asp-action="Blog" class="block mt-2">
                            <p class="text-xl font-semibold text-gray-900">The Essence of Swiss Design</p>
                            <p class="mt-3 text-base text-gray-500">Discover the principles of order, clarity, and objectivity that define one of the most influential design movements.</p>
                        </a>
                    </div>
                    <div class="mt-6 flex items-center">
                        <div class="flex-shrink-0">
                            <span class="sr-only">Herman Schmidt</span>
                            <img class="h-10 w-10 rounded-full" src="https://i.pravatar.cc/40?u=1" alt="">
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-gray-900">Herman Schmidt</p>
                            <div class="flex space-x-1 text-sm text-gray-500">
                                <time datetime="2025-09-15">Sep 15, 2025</time>
                                <span aria-hidden="true">&middot;</span>
                                <span>6 min read</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Blog Card 2 -->
            <div class="flex flex-col rounded-lg shadow-sm border border-gray-200 overflow-hidden">
                <div class="flex-shrink-0">
                     <img class="h-48 w-full object-cover" src="https://placehold.co/600x400/e2e8f0/e2e8f0" alt="">
                </div>
                <div class="flex-1 bg-white p-6 flex flex-col justify-between">
                    <div class="flex-1">
                        <p class="text-sm font-medium text-gray-500">
                            <a href="#" class="hover:underline">Productivity</a>
                        </p>
                        <a asp-controller="Articles" asp-action="Blog" class="block mt-2">
                            <p class="text-xl font-semibold text-gray-900">Markdown for Structured Writing</p>
                            <p class="mt-3 text-base text-gray-500">Learn how a simple text format can revolutionize your writing workflow and bring structure to your thoughts.</p>
                        </a>
                    </div>
                    <div class="mt-6 flex items-center">
                        <div class="flex-shrink-0">
                            <span class="sr-only">Jane Doe</span>
                            <img class="h-10 w-10 rounded-full" src="https://i.pravatar.cc/40?u=2" alt="">
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-gray-900">Jane Doe</p>
                            <div class="flex space-x-1 text-sm text-gray-500">
                                <time datetime="2025-09-12">Sep 12, 2025</time>
                                <span aria-hidden="true">&middot;</span>
                                <span>8 min read</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Blog Card 3 -->
            <div class="flex flex-col rounded-lg shadow-sm border border-gray-200 overflow-hidden">
                <div class="flex-shrink-0">
                    <img class="h-48 w-full object-cover" src="https://placehold.co/600x400/e2e8f0/e2e8f0" alt="">
                </div>
                <div class="flex-1 bg-white p-6 flex flex-col justify-between">
                    <div class="flex-1">
                        <p class="text-sm font-medium text-gray-500">
                            <a href="#" class="hover:underline">Technology</a>
                        </p>
                        <a asp-controller="Articles" asp-action="Blog" class="block mt-2">
                            <p class="text-xl font-semibold text-gray-900">The Rise of Static Site Generators</p>
                            <p class="mt-3 text-base text-gray-500">Exploring the benefits of performance, security, and simplicity in modern web development.</p>
                        </a>
                    </div>
                    <div class="mt-6 flex items-center">
                        <div class="flex-shrink-0">
                            <span class="sr-only">Klaus Richter</span>
                            <img class="h-10 w-10 rounded-full" src="https://i.pravatar.cc/40?u=3" alt="">
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium text-gray-900">Klaus Richter</p>
                            <div class="flex space-x-1 text-sm text-gray-500">
                                <time datetime="2025-09-10">Sep 10, 2025</time>
                                <span aria-hidden="true">&middot;</span>
                                <span>5 min read</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </div>
        </section>
</main>
